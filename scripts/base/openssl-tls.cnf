# Config OpenSSL TLS de NeonRelay, chargée via OPENSSL_CONF (jamais en global) :
#   - serveur : launch.sh (dev) ; en prod, même contenu dans
#     /etc/neonrelay/openssl.cnf (Environment=OPENSSL_CONF=… du service systemd)
#   - clients : base/_tls.sh (curl + Python des scripts)
#
# TLS 1.3 uniquement, échange de clés post-quantique OBLIGATOIRE :
#   SecP384r1MLKEM1024 (ML-KEM-1024, catégorie 5) en priorité,
#   X25519MLKEM768 en repli (clients par défaut). X25519 seul est refusé.
# OpenSSL ≥ 3.5 requis.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.3
Groups = SecP384r1MLKEM1024:X25519MLKEM768
